# ==============================================================================
# .gitignore for Academic Claude Code Projects
# ==============================================================================

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.snm
*.toc
*.vrb
*.synctex.gz
*.run.xml
*-blx.bib

# Compiled PDFs (uncomment to track specific PDFs)
# *.pdf

# Python
__pycache__/
*.pyc
*.pyo

# R
.Rproj.user/
.Rhistory
.RData
.Rdata

# OS files
.DS_Store
Thumbs.db

# Claude Code local files (not shared across machines)
.claude/settings.local.json
.claude/state/
CLAUDE.local.md

# IDE
# .vscode/ is developer-machine-specific, settings.json included. The template used to ship
# settings.json with bypassPermissions switched on; since 2026-09-10 it is not published, so
# nobody who opens this public repo starts with permission prompts off. Create it locally if
# you want those keys — TROUBLESHOOTING.md "Permissions / bypass / statusline" has the names.
.vscode/
.idea/
*.swp
*.swo
*~

# Quarto rendering artifacts
.quarto/

# quality_reports/ — KEPT IN VERSION CONTROL for this repo.
# Upstream excludes these because a *template* should not ship project-internal
# content. This is a real course project: plans, specs, session logs, and merge
# reports are part of the record and stay tracked.

# R analysis outputs (generated artifacts; keep scripts, ignore outputs)
scripts/R/_outputs/

# Output artifacts — uncomment lines below based on your preference
# *.rds
# output/**/*.rds

# Quarto render artifacts beside their .qmd sources (regenerable; quality_score
# renders them during gating). Published HTML lives in docs/, never here.
# Quarto/*.html is TRACKED here (docs/ is synced from it by scripts/sync_to_docs.sh)
Quarto/*_files/
# Quarto leaves these beside a lab when a figure is written to disk rather than
# embedded; they are render byproducts, regenerated on every render.
Labs/*_files/
Homework/*_files/

# stray 0-byte file from a shell redirect typo
null

# M5 raw download (~460 MB unzipped) — never commit. Rebuild with:
#   curl -L -o m5.zip https://github.com/Nixtla/m5-forecasts/raw/main/datasets/m5.zip
#   unzip m5.zip -d data/raw/
#   python scripts/prep_m5.py
data/raw/
*.zip

# Processed CSVs ARE tracked (small, and it means students can start without the
# 48 MB download). Regenerate them with scripts/prep_m5.py.
!data/processed/

# Solution keys and their narration — NOT COMMITTED.
# This repo serves GitHub Pages from docs/, which on a free account means it is
# public. Committing solutions would publish them. They live on disk only; move
# them to a private repo or Canvas if you want them version-controlled.
Homework/solutions/
Narration/*_solutions_script.md

# local virtualenv
.venv/

# local virtualenvs (any Python version) and Quarto build artifacts
.venv*/
*.quarto_ipynb

# rendered previews next to sources (deployed copies live in docs/)
Homework/*.html
Labs/*.html

# Book chapters are GENERATED from the decks and narration by
# scripts/build_book.py. They are disposable output — edit the deck or the
# narration, never the chapter. Committing them would create the fourth copy of
# every number that the generator exists to prevent.
book/chapters/
workbook/chapters/
book/.quarto/
workbook/.quarto/
workbook/.gitignore
# Quarto writes this on every render of the book project.
book/.gitignore
book/_book/
